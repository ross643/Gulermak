		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		},
		{
			"type": "composer",
			"url": "https://connect.advancedcustomfields.com"
		},
		{
			"type": "vcs",
			"url": "git@github.com:fishtankdevs/gravityforms.git"
		},
		{
			"type": "vcs",
			"url": "git@github.com:fishtankdevs/gravitysmtp.git"
		}
	],
	"require": {
		"php": ">=8.2",
		"vlucas/phpdotenv": "^5.6",
		"wpengine/advanced-custom-fields-pro": "6.7.0.2",
		"fishtankdevs/gravityforms": "^2.7.9",
		"fishtankdevs/gravitysmtp": "^2.1.3",
		"wpackagist-plugin/webp-express": "^0.25.14",
		"wpackagist-plugin/wordpress-seo": "^26.9"
	},
	"extra": {
		"installer-paths": {
			"wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			],
			"wp-content/themes/{$name}/": [
				"type:wordpress-theme"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
