		"typography": {
			"customFontSize": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"dropCap": false,
			"fontSizes": [],
			"fontFamilies": [
				{
					"fontFamily": "Poppins,sans-serif",
					"name": "Poppins",
					"slug": "poppins"
				}
			]
		},
		"layout": {
			"contentSize": null,
			"wideSize": null
		},
		"custom": {
			"navigationStyle": 1,
			"footerStyle": 1
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "18px",
			"fontWeight": "400",
			"lineHeight": "1.4"
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": false
				}
			}
		}
	}
}